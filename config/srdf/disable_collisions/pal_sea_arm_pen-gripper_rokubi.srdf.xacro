<?xml version="1.0" ?>
<robot name="pal_sea_arm" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find pal_sea_arm_moveit_config)/config/srdf/disable_collisions/pal_sea_arm_no-ee_rokubi.srdf.xacro" />
    <disable_collisions link1="arm_6_link" link2="pen_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm_7_link" link2="pen_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm_tool_link" link2="pen_gripper_base_link" reason="Never"/>
    <disable_collisions link1="pen_gripper_base_link" link2="wrist_ft_link" reason="Default"/>
    <disable_collisions link1="pen_gripper_base_link" link2="wrist_ft_tool_link" reason="Adjacent"/>
    <disable_collisions link1="pen_gripper_base_link" link2="world" reason="Never"/>
</robot>
